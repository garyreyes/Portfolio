---
import type { Project } from '../queries';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { data, id: slug } = project;

/**
 * One row in the work list.
 *
 * Honest status labels (docs/PRD.md §10, ARCHITECTURE.md "Project" table):
 * the STATUS WORD and the ACTUAL LINK are two separate decisions. The label
 * always shows the real status. The link only ever points at something that
 * actually exists — never a "Live" affordance with nowhere to go (Cornerman
 * has no liveUrl; this must not render one anyway).
 */
const STATUS_LABEL: Record<typeof data.status, string> = {
  live: 'Live',
  'android-apk': 'Android APK',
  archived: 'Archived',
};

// "Real client (unpaid)" stays on the card, not just in internal docs — the
// binding honesty constraint (PROJECT_FACTS.md) is that this site may say
// available for freelance but must never imply trusted by businesses.
const CLIENT_LABEL: Record<typeof data.client, string> = {
  self: 'Self-directed',
  'real-client': 'Real client (unpaid)',
  practice: 'Practice build',
};

const link = data.liveUrl
  ? { href: data.liveUrl, label: 'Live site' }
  : data.repoUrl
    ? { href: data.repoUrl, label: 'View repo' }
    : null;
---

<li class="py-block">
  <div class="gap-gutter flex flex-wrap items-baseline justify-between">
    <p class="text-lede font-semibold">{data.name}</p>
    <p class="text-meta text-ink-muted">{STATUS_LABEL[data.status]}</p>
  </div>

  <p class="text-ink-muted mt-gutter line-clamp-2" title={data.stack.join(' · ')}>
    {data.stack.join(' · ')}
  </p>
  <p class="text-meta text-ink-muted mt-gutter">{CLIENT_LABEL[data.client]}</p>

  <div class="mt-gutter gap-block flex flex-wrap items-center">
    {
      data.tier === 'hero' && (
        <a href={`/work/${slug}`} class="text-meta text-ink hover:underline">
          View brief
        </a>
      )
    }
    {
      link && (
        <a
          href={link.href}
          class="text-meta text-ink hover:underline"
          target="_blank"
          rel="noopener noreferrer"
        >
          {link.label}
        </a>
      )
    }
  </div>
</li>
