---
import type { Project } from '../queries';
import { STATUS_LABEL, CLIENT_LABEL, PLATFORM_LABEL, LINK_LABEL } from '../../../shared/projects';
import { WORK_BRIEFS_LIVE } from '../../../lib/site';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { data, id: slug } = project;

/**
 * One row of the work ledger: a metadata rail, then the content column.
 *
 * Honest status labels (docs/PRD.md §10): the STATUS WORD and the ACTUAL
 * LINK are two separate decisions. The label always shows the real status
 * (from shared/projects.ts). The link only ever points at something that
 * actually exists — never a "Live" affordance with nowhere to go (Cornerman
 * has no liveUrl; this must not render one anyway).
 */
const link = data.liveUrl
  ? { href: data.liveUrl, label: LINK_LABEL.live }
  : data.repoUrl
    ? { href: data.repoUrl, label: LINK_LABEL.repo }
    : null;
---

<li class="ledger-row py-block">
  {/* Rail: an inline row above the name on mobile, a column on sm+. */}
  <div class="text-meta text-ink-muted gap-x-tight flex flex-wrap sm:flex-col sm:gap-x-0">
    <span>{STATUS_LABEL[data.status]}</span>
    <span aria-hidden="true" class="sm:hidden">·</span>
    <span>{CLIENT_LABEL[data.client]}</span>
    <span aria-hidden="true" class="sm:hidden">·</span>
    <span>{PLATFORM_LABEL[data.type]}</span>
  </div>

  <div>
    <h3 class="text-name font-semibold">{data.name}</h3>
    <p class="mt-tight">{data.tagline}</p>
    <p class="text-meta text-ink-muted mt-gutter line-clamp-2" title={data.stack.join(' · ')}>
      {data.stack.join(' · ')}
    </p>

    {
      /* py-tight on the links lifts the hit target to ~35px (WCAG 2.5.8);
        -my-tight keeps the visible rhythm unchanged. */
    }
    <div class="gap-x-block gap-y-gutter mt-gutter flex flex-wrap items-center">
      {
        data.tier === 'hero' && WORK_BRIEFS_LIVE && (
          <a
            href={`/work/${slug}`}
            class="text-meta text-ink -my-tight py-tight underline underline-offset-4 hover:decoration-2"
          >
            View brief
          </a>
        )
      }
      {
        link && (
          <a
            href={link.href}
            class="text-meta text-ink -my-tight py-tight underline underline-offset-4 hover:decoration-2"
            target="_blank"
            rel="noopener noreferrer"
          >
            {link.label}
          </a>
        )
      }
    </div>
  </div>
</li>
