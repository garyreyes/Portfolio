---
import type { Project } from '../queries';
import ProjectCard from './ProjectCard.astro';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

{
  /* first/last row drop their outer py-block so the list sits a clean
     section's-worth below the rule above it, not a section + a row's pad.
     divide-y already omits the border above the first row / below the last. */
}
<ul class="divide-rule flex flex-col divide-y [&>li:first-child]:pt-0 [&>li:last-child]:pb-0">
  {projects.map((project) => <ProjectCard project={project} />)}
</ul>
