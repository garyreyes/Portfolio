---
import type { Project } from '../queries';
import ProjectCard from './ProjectCard.astro';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<ul class="mt-gutter gap-gutter grid sm:grid-cols-2">
  {
    projects.map((project, index) => (
      <ProjectCard project={project} lot={String(index + 1).padStart(2, '0')} />
    ))
  }
</ul>
