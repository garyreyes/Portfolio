---
import { SITE, NAV_LINKS } from '../../lib/site';

/**
 * Persistent top bar, every route (docs/user-flows.md "Navigation
 * convention"). Wordmark left (→ homepage / scroll-to-top), four plain
 * links right. Sticks to the viewport top on scroll.
 *
 * 2026-09-10, plain-text reset: the hazard-rule strip under the bar is
 * replaced by a plain <hr>; the stencil/uppercase link treatment is gone.
 * Below `sm` the wordmark and link row stack, and the links become a
 * one-per-line list rather than an uneven wrap — deliberate stacking reads
 * as intentional, wrap-induced stacking reads as broken.
 */
---

<header class="bg-page px-gutter max-w-page sticky top-0 z-40 mx-auto">
  <div
    class="py-gutter gap-gutter flex flex-col items-start sm:flex-row sm:items-center sm:justify-between"
  >
    <a href="/" data-wordmark class="text-lede text-ink font-semibold"> {SITE.name} </a>
    <nav
      class="gap-gutter flex flex-col items-start sm:flex-row sm:flex-wrap sm:items-center"
      aria-label="Site"
    >
      {
        /* py-tight lifts the hit target to ~35px (WCAG 2.5.8). No negative
           margin here — below sm the links stack and it would eat the gap. */
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class="text-meta text-ink-muted hover:text-ink py-tight underline-offset-4 hover:underline"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
  <hr />
</header>

<script>
  // Wordmark: scroll-to-top when already home, real navigation otherwise.
  // The CSS `scroll-behavior: auto` reduced-motion override in global.css
  // does NOT catch this — an explicit `behavior: 'smooth'` in a JS call
  // wins over that CSS property, so reduced motion has to be checked here
  // directly, not assumed to be handled globally.
  const wordmark = document.querySelector<HTMLElement>('[data-wordmark]');

  wordmark?.addEventListener('click', (event) => {
    if (window.location.pathname !== '/') return;
    event.preventDefault();
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
  });
</script>
