---
import { SITE, NAV_LINKS } from '../../lib/site';

/**
 * Persistent top bar, every route (docs/user-flows.md "Navigation
 * convention"). Wordmark left (→ homepage / scroll-to-top), four plain
 * links right. Sticks to the viewport top on scroll.
 *
 * 2026-09-10, plain-text reset: the hazard-rule strip under the bar is
 * replaced by a plain <hr>; the stencil/uppercase link treatment is gone.
 *
 * Single row at every width — wordmark left, the links right, no wrap. Two
 * short links ("Projects", "Contact") fit beside the wordmark down past
 * 320px, so the earlier below-`sm` vertical stack (a leftover from when
 * there were four links) is gone. When 5b/5c re-add Services + How I build,
 * that pass adds a mobile disclosure menu — four links, one long, won't fit.
 */
---

<header class="bg-page px-gutter max-w-page sticky top-0 z-40 mx-auto">
  <div class="py-gutter gap-gutter flex items-center justify-between">
    <a href="/" data-wordmark class="text-lede text-ink shrink-0 font-semibold">{SITE.name}</a>
    <nav class="gap-gutter flex shrink-0 items-center" aria-label="Site">
      {
        /* py-tight lifts the hit target to ~35px (WCAG 2.5.8); -my-tight
           keeps the header's visible height tight. */
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class="text-meta text-ink-muted hover:text-ink -my-tight py-tight underline-offset-4 hover:underline"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
  <hr />
</header>

<script>
  // Wordmark: scroll-to-top when already home, real navigation otherwise.
  // The CSS `scroll-behavior: auto` reduced-motion override in global.css
  // does NOT catch this — an explicit `behavior: 'smooth'` in a JS call
  // wins over that CSS property, so reduced motion has to be checked here
  // directly, not assumed to be handled globally.
  const wordmark = document.querySelector<HTMLElement>('[data-wordmark]');

  wordmark?.addEventListener('click', (event) => {
    if (window.location.pathname !== '/') return;
    event.preventDefault();
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
  });
</script>
