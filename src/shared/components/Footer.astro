---
import { SOCIALS } from '../../lib/site';

/**
 * Sitewide footer shell (docs/user-flows.md "Footer — sitewide, on every
 * route"). Socials ship now — nothing blocks them. The contact form and
 * stat block are Phase 5d; until then the footer says so plainly rather
 * than looking unfinished.
 *
 * 2026-09-10, plain-text reset: hazard-rule and the rotated status stamp
 * are gone — a single <hr>, plain links, a plain © line.
 */
---

<footer id="site-footer" class="px-gutter max-w-column mx-auto">
  <hr class="mt-section" />
  <div class="py-block gap-gutter flex flex-wrap items-center justify-between">
    <ul class="gap-block flex">
      {
        SOCIALS.map((social) => (
          <li>
            <a
              href={social.href}
              class="text-meta text-ink-muted hover:text-ink hover:underline"
              target={social.href.startsWith('http') ? '_blank' : undefined}
              rel={social.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            >
              {social.label}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="text-meta text-ink-muted">Contact form to follow</p>
  </div>
  <p class="text-meta text-ink-muted pb-section">© 2026 Gary Reyes — Manila, Philippines</p>
</footer>
