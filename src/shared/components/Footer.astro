---
import { SOCIALS } from '../../lib/site';
import { getContributionsMeta } from '../../lib/contributions';

/**
 * Sitewide footer (docs/user-flows.md "Footer — sitewide, on every route").
 * The nav "Contact" link scrolls here, so this has to read as a contact
 * point: an explicit "Email <address>" action on the left, the profile
 * links (GitHub, LinkedIn) on the right.
 *
 * The real contact form + stat block are Phase 5d. Until then this is the
 * contact surface — no "form to follow" placeholder (it read as unfinished
 * to the skeptical audience the footer exists to persuade).
 *
 * The contribution graph below the socials is a real, auto-updating asset
 * (public/contributions.svg), regenerated by a scheduled GitHub Action —
 * never a client-side fetch, never a CSP change (see
 * scripts/generate-contributions.mjs, .github/workflows/update-contributions.yml).
 * It sits alongside the eventual stat block (2026-08-28's cut reasoning was
 * about REPLACING the stat block with the graph, not about never showing
 * the graph at all — see PROJECT_FACTS.md "Contribution graph"). The alt
 * text and dimensions below come from lib/contributions.ts, which reads
 * the generated SVG's own title element and size at build time — an SVG
 * loaded as an image never exposes its title element to anything (no
 * screen reader, no tooltip), so the accessible name has to be supplied
 * on this element, not inside the SVG file itself.
 */
const email = SOCIALS.find((s) => s.href.startsWith('mailto:'));
const profiles = SOCIALS.filter((s) => !s.href.startsWith('mailto:'));
const emailAddress = email?.href.replace('mailto:', '');
const contributions = getContributionsMeta();
---

<footer id="site-footer" class="px-gutter max-w-page mx-auto">
  <hr class="mt-section" />
  <div class="py-block gap-gutter flex flex-wrap items-baseline justify-between">
    {
      email && (
        <p class="text-meta">
          <span class="text-ink-muted">Get in touch — </span>
          <a
            href={email.href}
            class="text-ink -my-tight py-tight underline underline-offset-4 hover:decoration-2"
          >
            {emailAddress}
          </a>
        </p>
      )
    }
    <ul class="gap-block flex">
      {
        profiles.map((social) => (
          <li>
            <a
              href={social.href}
              class="text-meta text-ink-muted hover:text-ink -my-tight py-tight underline underline-offset-4 hover:decoration-2"
              target="_blank"
              rel="noopener noreferrer"
            >
              {social.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <img
    src="/contributions.svg"
    alt={contributions.alt}
    width={contributions.width}
    height={contributions.height}
    loading="lazy"
    decoding="async"
    class="mb-block"
  />
  <p class="text-meta text-ink-muted pb-section">© 2026 Gary Reyes — Manila, Philippines</p>
</footer>
