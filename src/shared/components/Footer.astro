---
import { SOCIALS } from '../../lib/site';
import { getContributionsMeta } from '../../lib/contributions';
import ContactForm from '../../features/contact/components/ContactForm';
import StatBlock from './StatBlock.astro';

/**
 * Sitewide footer (docs/user-flows.md "Footer — sitewide, on every route").
 * The nav "Contact" link scrolls here. ROADMAP 5d: the real contact form is
 * now the primary action — `client:visible` since it's below the fold, so
 * it hydrates only once scrolled into view (this site's first React
 * island). The plain email link stays as an always-available fallback,
 * both for a visitor who prefers email and for the (rare) case the island
 * hasn't hydrated yet; the form's own <form action> also works with zero
 * JavaScript (see ContactForm.tsx).
 *
 * The stat block and the contribution graph are supporting facts, not the
 * primary action — kept visually secondary, below the form.
 *
 * The contribution graph (public/contributions.svg) is a real,
 * auto-updating asset, regenerated by a scheduled GitHub Action — never a
 * client-side fetch, never a CSP change (see
 * scripts/generate-contributions.mjs, .github/workflows/update-contributions.yml).
 * alt/width/height come from lib/contributions.ts, which reads the
 * generated SVG's own title element and size at build time — loading an
 * SVG through an image tag never exposes that file's internal title
 * element to anything, so the accessible name has to be supplied on this
 * element, not inside the SVG file itself.
 */
const email = SOCIALS.find((s) => s.href.startsWith('mailto:'));
const profiles = SOCIALS.filter((s) => !s.href.startsWith('mailto:'));
const emailAddress = email?.href.replace('mailto:', '');
const contributions = getContributionsMeta();
---

<footer id="site-footer" class="px-gutter max-w-page mx-auto">
  <hr class="mt-section" />

  <div class="py-block">
    <h2 class="text-lede">Get in touch</h2>
    <div class="mt-gutter max-w-column">
      <ContactForm client:visible />
    </div>
    {
      email && (
        <p class="text-meta text-ink-muted mt-gutter">
          Prefer email?{' '}
          <a
            href={email.href}
            class="text-ink -my-tight py-tight underline underline-offset-4 hover:decoration-2"
          >
            {emailAddress}
          </a>
        </p>
      )
    }
  </div>

  <div class="pb-block gap-gutter flex flex-wrap items-baseline justify-between">
    <StatBlock />
    <ul class="gap-block flex">
      {
        profiles.map((social) => (
          <li>
            <a
              href={social.href}
              class="text-meta text-ink-muted hover:text-ink -my-tight py-tight underline underline-offset-4 hover:decoration-2"
              target="_blank"
              rel="noopener noreferrer"
            >
              {social.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <img
    src="/contributions.svg"
    alt={contributions.alt}
    width={contributions.width}
    height={contributions.height}
    loading="lazy"
    decoding="async"
    class="mb-block"
  />

  <p class="text-meta text-ink-muted pb-section">© 2026 Gary Reyes — Manila, Philippines</p>
</footer>
