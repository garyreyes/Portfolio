---
import { SOCIALS } from '../../lib/site';
import { getContributionsMeta } from '../../lib/contributions';
import StatBlock from './StatBlock.astro';

/**
 * Sitewide footer (docs/user-flows.md "Footer — sitewide, on every route").
 * The nav "Contact" link scrolls here. The Web3Forms contact form (ROADMAP
 * 5d) was removed 2026-10-01 at Gary's call — the plain email address in
 * the "Connect" row near the bottom is the contact path now.
 *
 * The contribution graph (public/contributions.svg) is a real,
 * auto-updating asset, regenerated by a scheduled GitHub Action — never a
 * client-side fetch, never a CSP change (see
 * scripts/generate-contributions.mjs, .github/workflows/update-contributions.yml).
 * alt/width/height come from lib/contributions.ts, which reads the
 * generated SVG's own title element and size at build time — loading an
 * SVG through an image tag never exposes that file's internal title
 * element to anything, so the accessible name has to be supplied on this
 * element, not inside the SVG file itself. The image links out to the
 * real GitHub profile (where the actual, interactive calendar lives) —
 * this static SVG is a snapshot, not a substitute for it.
 *
 * The link wrapper is `block` with an explicit pixel `width` (not
 * `inline-block` relying on shrink-to-fit) — verified live in Chrome that
 * `inline-block` here collapses the image to ~32px: an auto-width
 * inline-block whose only content is an `img` with Tailwind's default
 * `max-width:100%` hits a circular sizing dependency (the anchor's
 * shrink-to-fit width depends on the image's resolved width, which
 * depends on the anchor's width) that Chromium resolves wrong. `block` +
 * a real pixel `width` (not shrink-to-fit, and not `max-width` either —
 * see below) sidesteps it entirely.
 *
 * The image never shrinks below its real 634px width — it used to (via
 * `max-width` + `w-full h-auto`), which meant the SVG's own baked-in
 * month-label text (fixed font-size, part of the generated image, not
 * CSS-stylable) shrank below legible size on narrow viewports
 * (/impeccable critique 2026-09-13, P2). The outer `overflow-x-auto`
 * wrapper lets the graph scroll horizontally within its own box on
 * mobile instead — the same pattern GitHub's own contribution calendar
 * uses there — which keeps every label readable without ever scrolling
 * the page body itself (CLAUDE.md's "no horizontal body scroll" is about
 * `<body>`, not a single scoped, intentionally-scrollable element).
 *
 * That wrapper defaults to its LEFT edge on load — the calendar's oldest,
 * sparsest months — unless something moves it. The inline script below
 * scrolls it to the right edge (the most recent, densest activity) on
 * mount, so a mobile visitor's first view is the graph's actual proof,
 * not its emptiest stretch (/impeccable layout 2026-09-13, finding 4).
 * A no-op wherever the wrapper isn't actually scrollable.
 */
const email = SOCIALS.find((s) => s.href.startsWith('mailto:'));
const emailAddress = email?.href.replace('mailto:', '');
const github = SOCIALS.find((s) => s.label === 'GitHub');
const contributions = getContributionsMeta();

/**
 * The bottom "Connect" row (below the contribution graph) is
 * LinkedIn → GitHub → Email, deliberately reordered from SOCIALS' own
 * GitHub-first order (which the homepage header keeps, matching
 * affaanmustafa.com's GitHub/LinkedIn placement right under the name —
 * Gary's reference, 2026-09-13). Email shows its real address as the link
 * text, not the generic "Email" label, so it's scannable on its own the
 * way GitHub/LinkedIn's real usernames would be if this site showed them.
 */
const connectLinks = [
  SOCIALS.find((s) => s.label === 'LinkedIn'),
  SOCIALS.find((s) => s.label === 'GitHub'),
  email,
].filter((s): s is (typeof SOCIALS)[number] => s !== undefined);
---

<footer id="site-footer" class="px-gutter max-w-page mx-auto">
  <hr class="mt-section" />

  <div class="pt-block pb-block">
    <StatBlock />
  </div>

  <div class="mb-block overflow-x-auto" data-contributions-scroll>
    <a
      href={github?.href}
      class="duration-quick -my-tight py-tight block transition-opacity hover:opacity-70"
      style={`width:${contributions.width}px`}
      target="_blank"
      rel="noopener noreferrer"
    >
      <img
        src="/contributions.svg"
        alt={`${contributions.alt} — view on GitHub`}
        width={contributions.width}
        height={contributions.height}
        decoding="async"
      />
    </a>
  </div>

  <ul class="gap-block mb-block flex flex-wrap">
    {
      connectLinks.map((social) => {
        const isEmail = social.href.startsWith('mailto:');
        return (
          <li>
            <a
              href={social.href}
              class="text-meta text-ink-muted hover:text-ink -my-tight py-tight underline underline-offset-4 hover:decoration-2"
              target={isEmail ? undefined : '_blank'}
              rel={isEmail ? undefined : 'noopener noreferrer'}
            >
              {isEmail ? emailAddress : social.label}
            </a>
          </li>
        );
      })
    }
  </ul>

  <p class="text-meta text-ink-muted pb-section">© 2026 Gary Reyes — Manila, Philippines</p>
</footer>

<script>
  // See the doc comment above the contributions wrapper: open the graph
  // scrolled to its most recent activity, not its sparsest.
  const contributionsScroll = document.querySelector<HTMLElement>('[data-contributions-scroll]');
  if (contributionsScroll) {
    contributionsScroll.scrollLeft = contributionsScroll.scrollWidth;
  }
</script>
