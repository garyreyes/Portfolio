---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, SOCIALS } from '../lib/site';
import { getOrderedProjects } from '../features/projects/queries';
import ProjectGrid from '../features/projects/components/ProjectGrid.astro';

/**
 * Homepage: intro → about → projects → footer. That order is Gary's call
 * (2026-09-10), overriding docs/user-flows.md's original intro → work →
 * about — the reader meets who Gary is before scanning the projects.
 *
 * The about paragraph is an INTERIM factual version. A fuller first-person
 * bio (the self-taught path, IE-as-systems, boxing → Cornerman, coffee →
 * Pahinga) is a tracked follow-up (PROJECT_FACTS.md "Homepage about
 * section"). Swap it in as a plain edit to this block — no structural
 * change. The homepage never claims the AI-assisted build method
 * (docs/PRD.md §4 — that is /how-i-build's job).
 *
 * The internship line used to be the last clause of the About paragraph —
 * same visual weight as "Cornerman was the first project I shipped," so a
 * skimmer had no reason to notice it (/impeccable critique 2026-09-13,
 * P1). Pulled onto its own line at `text-lede` size, with "reach out"
 * as a real link to the footer's contact links, not a decorative phrase.
 * Wording is Gary's own choice from a set of drafted options — a warmer
 * nudge over a bare status line, but still one sentence, no pitch.
 */

const projects = await getOrderedProjects();
const profiles = SOCIALS.filter((s) => !s.href.startsWith('mailto:'));
---

<BaseLayout title={SITE.name} description={SITE.description}>
  <div class="py-section">
    <header>
      <h1 class="text-title">Gary Reyes</h1>
      <p class="text-lede text-ink-muted max-w-column mt-gutter">
        Third-year Industrial Engineering student at De La Salle University. I ship production
        software.
      </p>
      <ul class="gap-block mt-gutter flex flex-wrap">
        {
          profiles.map((social) => (
            <li>
              <a
                href={social.href}
                class="text-meta text-ink-muted hover:text-ink -my-tight py-tight underline underline-offset-4 hover:decoration-2"
                target="_blank"
                rel="noopener noreferrer"
              >
                {social.label}
              </a>
            </li>
          ))
        }
      </ul>
    </header>

    <hr class="my-section" />

    <section id="about">
      <h2 class="sr-only">About</h2>
      <p class="max-w-column">
        I'm self-taught. Cornerman was the first project I shipped. Three of the four projects here
        are built for real use; the fourth I built to learn.
      </p>
      <p class="text-lede mt-gutter max-w-column">
        Looking for a startup internship —{' '}
        <a href="/#site-footer" class="underline underline-offset-4 hover:decoration-2">
          reach out
        </a>{' '}
        if this looks like a fit.
      </p>
    </section>

    <hr class="my-section" />

    <section id="projects">
      <h2 class="sr-only">Projects</h2>
      <ProjectGrid projects={projects} />
    </section>
  </div>
</BaseLayout>
