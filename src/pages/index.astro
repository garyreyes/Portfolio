---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site';
import { getOrderedProjects } from '../features/projects/queries';
import ProjectGrid from '../features/projects/components/ProjectGrid.astro';

/**
 * Interim homepage — the hero intro and the work list. Phase 5a adds the
 * about / Industrial Engineering section and finalizes the copy. The intro
 * sentence here is real (docs/PRD.md positioning), not placeholder text.
 */

const projects = await getOrderedProjects();
---

<BaseLayout title={SITE.name} description={SITE.description}>
  <div class="py-section">
    <header>
      <h1 class="text-title">Gary Reyes</h1>
      <p class="text-lede text-ink-muted mt-gutter">
        Third-year Industrial Engineering student at De La Salle University. I ship production
        software.
      </p>
    </header>

    <hr class="my-section" />

    <section id="work">
      <h2 class="text-meta text-ink-muted">Work</h2>
      <ProjectGrid projects={projects} />
    </section>
  </div>
</BaseLayout>
