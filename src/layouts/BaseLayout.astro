---
import '../styles/global.css';
import SkipLink from '../shared/components/SkipLink.astro';
import Nav from '../shared/components/Nav.astro';
import Footer from '../shared/components/Footer.astro';

/**
 * Root layout. Every route renders through this.
 *
 * The direction contract below MUST remain the first child of <body> and
 * MUST survive the production build — it is the auditable record of the
 * visual world every component inherits. Do not move it into a child or
 * slotted component; Astro strips a slot's leading comment. An HTML comment
 * renders nothing, so SkipLink is still the first real element for keyboard
 * and screen-reader users despite following it in source.
 *
 * <main> owns the reading column (mx-auto max-w-column px-gutter), not each
 * page. Nav and Footer apply the same column width and gutter so all three
 * landmarks share one measure on every route.
 */
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <!--
    DIRECTION CONTRACT — plain-text portfolio (reset 2026-09-10)

    Supersedes the shipping-manifest direction (seed d4e5136b), retired after
    an affaanmustafa.com reference — Gary's call, the fourth and terminal
    walk-back of that direction (orange accent -> full-screen menu -> hazard
    bars -> the rest). Full history: PROJECT_FACTS.md "Visual direction".

    THESIS: Four shipped projects, stated plainly. The work carries the
    weight; the design gets out of its way. No metaphor, no ornament.

    WORLD: The platform's own UI font, no web fonts. Near-black ink (#171717)
    on off-white (#fbfbfb). One ~42rem reading column, left-aligned. Sections
    divided by a 1px hairline rule and whitespace, nothing heavier. No accent
    colour. Single light mode.

    FIRST VIEWPORT: Name as a modest h1, then one plain sentence — "Third-year
    Industrial Engineering student at De La Salle University. I ship
    production software." — then the work list begins. Primary action: open
    the first project.

    STORY: A founder reads two sentences, sees four real things shipped with
    live links and browsable code, and opens a brief.

    FINISH: unreviewed and undocumented is unfinished; this build ends with
    the finish review, the verdict, and DESIGN.md.
    -->
    <SkipLink />
    <Nav />
    <main id="main-content" class="px-gutter max-w-column mx-auto">
      <slot />
    </main>
    <Footer />
  </body>
</html>
