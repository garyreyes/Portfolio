# Force LF everywhere. Prettier (and the pre-push gate) expect LF, but a
# Windows checkout with core.autocrlf=true rewrites working files to CRLF,
# failing `prettier --check` on code CI passes. text=auto leaves binaries alone.
* text=auto eol=lf

# Cloudflare Pages parses public/_headers line by line — force LF so a
# Windows checkout cannot introduce a CR into a header value. (Covered by
# the rule above; kept explicit because it would break production.)
/public/_headers text eol=lf
